{
  "name": "@zengchaowu/react-ui",
  "version": "0.1.0",
  "description": "React 一比一复刻 @zengchaowu/vue-ui 的设计系统组件库",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css",
    "dist/style.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style": {
      "types": "./dist/style.d.ts",
      "node": "./dist/style.js",
      "import": "./dist/style.js",
      "default": "./dist/style.js"
    },
    "./dist/tailwind.css": "./dist/tailwind.css",
    "./dist/hairline.css": "./dist/hairline.css",
    "./dist/tokens.css": "./dist/tokens.css",
    "./dist/iconfont.css": "./dist/iconfont.css",
    "./dist/iconfont.js": "./dist/iconfont.js"
  },
  "files": [
    "dist",
    "src/assets/fileIconMaps.json"
  ],
  "scripts": {
    "scaffold": "node scripts/scaffold-from-vue-ui.mjs && node scripts/adapt-vue-types.mjs",
    "sync:package-exports": "node scripts/sync-package-exports.mjs",
    "check:component-parity": "node scripts/check-component-parity.mjs",
    "build": "vite build --mode lib && node scripts/sync-package-exports.mjs",
    "build:fast": "vite build --mode lib-fast && node scripts/sync-package-exports.mjs",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@zengchaowu/shared": "workspace:*"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.1.0",
    "@storybook/react": "^8.1.0",
    "@storybook/react-vite": "^8.1.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^8.1.0",
    "tailwindcss": "^3.4.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.9.0"
  },
  "keywords": [
    "react",
    "ui",
    "design-system",
    "zengchaowu"
  ],
  "author": "",
  "license": "ISC"
}
